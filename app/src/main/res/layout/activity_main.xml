<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" app:layout_constraintBottom_toTopOf="@id/bottomlayout" app:layout_constraintTop_toTopOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="40sp" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:textDirection="rtl" android:id="@+id/tvcontent"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/bottomlayout" android:orientation="vertical" android:gravity="center" app:layout_constraintBottom_toBottomOf="parent">
        <EditText android:layout_width="300dp" android:layout_height="wrap_content" android:id="@+id/tz" android:gravity="center" android:hint="תעודת זהות"/>
        <EditText android:layout_width="300dp" android:layout_height="wrap_content" android:id="@+id/fullname" android:gravity="center" android:hint="שם מלא"/>
        <EditText android:layout_width="300dp" android:layout_height="wrap_content" android:id="@+id/grade" android:gravity="center" android:hint="ציון סופי"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btnInsert" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="הוסף תלמיד"/>
            <Button android:id="@+id/btnSelect" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="הצג תלמידים"/>
            <Button android:id="@+id/btnUpdate" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="עדכן תלמיד"/>
            <Button android:id="@+id/btnDelete" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="מחק תלמיד"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>